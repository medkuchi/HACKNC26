# Environment variables for apps/web — copy to .env.local and fill in.
# Public (safe for client bundle):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=
NESSIE_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Shared secret used to authenticate requests coming from the
# apps/photon-agent worker into this app's internal API routes.
PHOTON_AGENT_SHARED_SECRET=

# Feature flag: when real Nessie/Gemini/Photon credentials are absent,
# lib/* adapters fall back to mock implementations instead of pretending
# mock data is real.
USE_MOCK_NESSIE=true
USE_MOCK_GEMINI=true
