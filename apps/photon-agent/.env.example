# Environment variables for apps/photon-agent — copy to .env and fill in.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Base URL of the deployed/local Bridge web app, and the shared secret
# used to authenticate this worker's calls into its API routes.
BRIDGE_API_BASE_URL=
PHOTON_AGENT_SHARED_SECRET=
# Optional: debug, info, warn, or error (default info).
LOG_LEVEL=info
