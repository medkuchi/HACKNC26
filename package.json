{
  "name": "hacknc26",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge \u2014 AI-powered financial companion for HackNC 2026. npm workspaces monorepo: apps/web (Next.js), apps/photon-agent (persistent iMessage worker), packages/shared (forecast engine + domain types).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:nessie": "node scripts/test-nessie.cjs",
    "test:forecast": "node scripts/test-nessie.cjs forecast",
    "test:schedule": "node --import tsx apps/web/src/lib/forecast/schedule.test.ts",
    "test:plans": "node scripts/test-nessie.cjs plans",
    "test:webhook": "node scripts/test-nessie.cjs webhook",
    "test:hooks": "node scripts/test-hooks.cjs",
    "test:agent": "node scripts/test-nessie.cjs agent",
    "test:dashboard": "node scripts/test-dashboard.cjs"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
